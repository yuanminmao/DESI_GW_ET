{
  "description": "SNR and analytic Gaussian Bayes factor for the first m data-defined PCA modes",
  "data_combination": "BBN + CMB(theta*) + DESI DR2 + absolute ET GW",
  "reference_model": "flat LCDM, w_i=-1",
  "mode_basis": "descending eigenvectors of F_data = inv(C_A001) - 0.01 P_Horndeski",
  "method": {
    "posterior_precision_m": "Q_m=E_m^T(F_data+P_Horndeski)E_m",
    "score_m": "j_m=E_m^T inv(C_A001) <w+1>_A001",
    "posterior_mean_m": "mu_m=inv(Q_m)j_m",
    "snr": "sqrt(mu_m^T Q_m mu_m)",
    "delta_ln_L": "SNR_m^2/2",
    "delta_ln_V": "[ln det(P_m)-ln det(Q_m)]/2",
    "ln_bayes_factor": "delta_ln_L+delta_ln_V",
    "ln_bayes_factor_sigma": "dynesty log-evidence integration error for the compressed Gaussian model (nlive=300, dlogz=0.1)"
  },
  "sign_convention": "positive ln_B_m_over_LCDM favors the m-mode w(z) model",
  "approximation": "Analytic Gaussian evidence compressed from converged A=0.01 MCMC chains; sigma is the nested-sampling integration error of this compressed model, not a data/model uncertainty",
